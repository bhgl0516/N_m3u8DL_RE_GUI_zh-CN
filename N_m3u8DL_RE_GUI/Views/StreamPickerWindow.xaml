<Window x:Class="N_m3u8DL_RE_GUI.Views.StreamPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择视频流"
        Height="360" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1C1C22"
        FontFamily="Microsoft YaHei UI"
        FontSize="15">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#5865F2"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#7A87FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4350D8"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3E4ACB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F8"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8888A8"/>
        <SolidColorBrush x:Key="BorderBrushCustom" Color="#66667C"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrushCustom}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="此捕获包含多个视频流。请选择要下载的一个 — 第一个通常是主播放列表。"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <ListBox Grid.Row="1"
                 x:Name="List_Candidates"
                 AutomationProperties.Name="捕获中发现的视频流候选"
                 MouseDoubleClick="List_Candidates_MouseDoubleClick"
                 Background="#141418"
                 BorderBrush="{StaticResource BorderBrushCustom}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Kind}" FontWeight="Bold"
                                   Foreground="{StaticResource AccentTextBrush}"/>
                        <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="Button_Cancel" Content="取消" IsCancel="True"
                    AutomationProperties.Name="取消视频流选择"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="90"/>
            <Button x:Name="Button_Use" Content="使用此视频流" IsDefault="True"
                    AutomationProperties.Name="使用选中的视频流"
                    Click="Button_Use_Click"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
