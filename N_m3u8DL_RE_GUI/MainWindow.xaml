<Window x:Class="N_m3u8DL_RE_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N_m3u8DL_RE_GUI"
        mc:Ignorable="d"
        Title="N_m3u8DL-RE GUI" 
        Height="660" Width="920"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Closing="Window_Closing" 
        Loaded="Window_Loaded"
        Background="#0D0D0F"
        FontFamily="Microsoft YaHei UI"
        FontSize="15"
        TextOptions.TextFormattingMode="Display"
        DataContext="{Binding Source={StaticResource Locator}, Path=MainViewModel}">
    
    <!-- These route to the window's own handlers via CommandBindings, NOT to MainViewModel.
         No control in this window binds to the ViewModel, so its DownloadOptions is always
         empty; commands aimed there reported "no URL" no matter what the user had typed.
         Alt+G is already supplied by the "_GO" access key, so it is not repeated here. -->
    <Window.InputBindings>
        <KeyBinding Gesture="Alt+S" Command="{x:Static local:MainWindow.StartDownloadRoutedCommand}"/>
        <KeyBinding Gesture="Escape" Command="{x:Static local:MainWindow.StopDownloadRoutedCommand}"/>
    </Window.InputBindings>
    
    <Window.Resources>
        <!-- Color Brushes. Ratios in comments are WCAG 2.1, verified by XamlContrastTests. -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0D0D0F"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#141418"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1C1C22"/>
        <!-- #2A2A38 measured 1.20:1 on Card — a border nobody could see. -->
        <SolidColorBrush x:Key="BorderBrushCustom" Color="#66667C"/>
        <!-- Accent as a SURFACE (button fill, tab indicator). White on it is 4.61:1. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5865F2"/>
        <!-- Accent as TEXT. #5865F2 was 3.68:1 on Card; this is 5.44:1. -->
        <SolidColorBrush x:Key="AccentTextBrush" Color="#7A87FF"/>
        <!-- Hover/pressed darken so contrast rises on interaction, never falls. -->
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4350D8"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3E4ACB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F8"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8888A8"/>
        <SolidColorBrush x:Key="CfAmberBrush" Color="#F39C12"/>
        <SolidColorBrush x:Key="CommandBarBrush" Color="#0A0A0D"/>
        <SolidColorBrush x:Key="CommandTextBrush" Color="#A8C0FF"/>
        <SolidColorBrush x:Key="DropLabelBrush" Color="#EC7063"/>

        <!-- Accessible Focus Visual Style for high visibility keyboard navigation -->
        <Style x:Key="AccessibleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="{StaticResource AccentBrush}"
                                   StrokeThickness="2" StrokeDashArray="1 1"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        
        <!-- TextBox Style -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <!-- Validation state arrives as a Tag, not as a local BorderBrush value.
                     A local value outranks style triggers in WPF property precedence, so
                     writing BorderBrush directly permanently removed the focus indicator
                     from TextBox_URL, TextBox_Proxy and TextBox_EXE. Declared first so the
                     focus and hover triggers below still win while the field is active. -->
                <Trigger Property="Tag" Value="invalid">
                    <Setter Property="BorderBrush" Value="{StaticResource DropLabelBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- CheckBox Style -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#2ECC71"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Primary Action Button Style -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrushCustom}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Update Pill Button Style -->
        <Style x:Key="UpdatePillButtonStyle" TargetType="Button">
            <!-- #1E8449 rather than #2ECC71: white on #2ECC71 measures 2.10:1, the worst
                 contrast in the window. #1E8449 gives 4.72:1 and clears WCAG AA. -->
            <Setter Property="Background" Value="#1E8449"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <!-- Ramp goes darker on interaction so contrast never drops below the
                     resting 4.72:1. The old ramp got lighter and fell to 2.87:1 on hover. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#196F3D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#145A32"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- GroupBox Style with full dark-theme template -->
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header pill -->
                            <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    Padding="10,5" CornerRadius="3,3,0,0">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                                  TextBlock.FontSize="13"/>
                            </Border>
                            <!-- Content area -->
                            <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,0,1,1"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="0,0,3,3">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ContextMenu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <!-- Dark ScrollBar / ScrollViewer -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2">
                <Grid x:Name="hasGroup">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource TextSecondaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="arrow" Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Dark Theme Styling (Fixes White Dropdown & Light Box Bug) -->
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrushCustom}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid">
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"/>

                            <ContentPresenter x:Name="contentTemplate"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="1"
                                   PopupAnimation="Slide"
                                   Placement="Bottom">
                                <Border x:Name="dropDownBorder"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrushCustom}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=mainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter TargetName="toggleButton" Property="Background" Value="#141418"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical TabControl Navigation Style -->
        <Style x:Key="LeftTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C1C22"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C1C22"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- ZONE A: Top Dock -->
            <RowDefinition Height="*"/>    <!-- ZONE B & C: Sidebar + Content -->
            <RowDefinition Height="Auto"/> <!-- ZONE D: Bottom Command Bar -->
        </Grid.RowDefinitions>

        <!-- ================== ZONE A: TOP DOCK ================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrushCustom}" BorderThickness="1"
                Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <!-- Title Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="N_m3u8DL-RE GUI" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}"/>
                        <TextBlock x:Name="TextBlock_AppVersion" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                        <Button x:Name="Button_UpdateBadge" AutomationProperties.Name="有可用新版本" Visibility="Collapsed"
                                Style="{StaticResource UpdatePillButtonStyle}"
                                Margin="10,0,0,0"
                                Click="Button_UpdateBadge_Click"
                                ToolTip="点击查看并下载 GitHub 上的最新版本"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="字体" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="Combo_UIFont" Width="150" VerticalAlignment="Center"
                                  SelectionChanged="Combo_UIFont_SelectionChanged"
                                  AutomationProperties.Name="界面字体"
                                  ToolTip="选择界面显示字体。可点「导入」加载任意 .ttf/.otf/.ttc 字体。推荐古籍宋体「京華老宋体-GJ」。"/>
                        <Button x:Name="Button_ImportFont" Content="导入" Style="{StaticResource SecondaryButtonStyle}"
                                Click="Button_ImportFont_Click" Margin="6,0,12,0" Padding="8,2" FontSize="13"
                                AutomationProperties.Name="导入字体文件"
                                ToolTip="从本地选择 .ttf / .otf / .ttc 字体文件并应用"/>
                        <CheckBox x:Name="CheckBox_TopMost" AutomationProperties.Name="窗口置顶" Style="{StaticResource CheckBoxStyle}"
                                  Content="窗口置顶" ToolTip="保持窗口在最前面"
                                  Checked="SetTopMost" Unchecked="SetTopMost"/>
                    </StackPanel>
                </Grid>

                <!-- Resume Interrupted Download Banner -->
                <Border x:Name="Border_ResumeBanner" Visibility="Collapsed"
                        Background="#2A2113" BorderBrush="{StaticResource CfAmberBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TextBlock_ResumeTitle" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource CfAmberBrush}"
                                       AutomationProperties.Name="未完成的下载"
                                       Text="⏸  未完成的下载"/>
                            <TextBlock x:Name="TextBlock_ResumeDetail" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                       AutomationProperties.Name="未完成下载详情"
                                       Text="检测到磁盘上有未下载完成的文件。"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="Button_ResumeJob" Content="继续下载"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="#3D3017" Foreground="{StaticResource CfAmberBrush}"
                                    BorderBrush="{StaticResource CfAmberBrush}"
                                    Padding="10,4" Margin="0,0,6,0"
                                    Click="Button_ResumeJob_Click"
                                    AutomationProperties.Name="继续未完成的下载"
                                    ToolTip="恢复下载设置并准备重新附加链接"/>
                            <Button x:Name="Button_DiscardJob" Content="放弃"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="Transparent" Foreground="#EC7063"
                                    BorderBrush="#7A2D27"
                                    Padding="10,4"
                                    Click="Button_DiscardJob_Click"
                                    AutomationProperties.Name="放弃未完成的下载"
                                    ToolTip="删除磁盘上的部分文件并清除续传数据"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- URL Hero Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输入链接" Style="{StaticResource LabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox Grid.Column="1" x:Name="TextBox_URL" Style="{StaticResource TextBoxStyle}" 
                             FontSize="15" TextChanged="TextChanged" AllowDrop="True"
                             PreviewKeyDown="TextBox_URL_PreviewKeyDown"
                             MouseDoubleClick="TextBox_URL_MouseDoubleClick"
                             PreviewDragOver="TextBox_URL_PreviewDragOver"
                             PreviewDrop="TextBox_URL_PreviewDrop"
                             PreviewDragEnter="TextBox_URL_PreviewDragEnter"
                             AutomationProperties.Name="输入链接或文件路径"
                             AutomationProperties.HelpText="M3U8/MPD 链接或本地文件路径"
                             ToolTip="M3U8/MPD/ISM 链接或本地文件路径。双击从剪贴板粘贴"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="Button_PasteCurl"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="📋 从浏览器粘贴"
                                Click="Button_PasteCurl_Click"
                                AutomationProperties.Name="从复制的 cURL 命令粘贴流链接和请求头"
                                ToolTip="在浏览器中按 F12 → 网络 → 右键点击流请求 → 复制 → 复制为 cURL，然后点击这里。"
                                Margin="0,0,6,0"/>
                        <Button x:Name="Button_GO" Content="▶ 下载" 
                                Style="{StaticResource ButtonStyle}"
                                Click="Button_GO_Click"
                                AutomationProperties.Name="开始下载"
                                AutomationProperties.HelpText="开始下载当前流"
                                ToolTip="开始下载 (Alt+G、Alt+S、Enter)"/>
                        <Button x:Name="Button_Stop" Content="⏹ 停止"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Background="#C0392B" Foreground="#FFFFFF" BorderThickness="0"
                                Click="Button_Stop_Click" Margin="6,0,0,0" Padding="12,6"
                                Visibility="Collapsed"
                                AutomationProperties.Name="停止下载"
                                AutomationProperties.HelpText="取消当前下载进程"
                                ToolTip="取消当前下载 (Alt+T、Esc)"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Path Sub-row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="保存目录" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="1" x:Name="TextBox_WorkDir" Style="{StaticResource TextBoxStyle}" 
                             TextChanged="TextChanged"
                             AutomationProperties.Name="保存目录路径"
                             ToolTip="下载输出目录"/>
                    <Button Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButtonStyle}"
                            Click="Button_SelectDir_Click" Margin="6,0,0,0"
                            AutomationProperties.Name="浏览保存目录"/>

                    <TextBlock Grid.Column="4" Text="保存名称" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="5" x:Name="TextBox_Title" Style="{StaticResource TextBoxStyle}" 
                             TextChanged="TextChanged"
                             PreviewKeyDown="TextBox_Title_PreviewKeyDown"
                             MouseDoubleClick="TextBox_Title_MouseDoubleClick"
                             AutomationProperties.Name="保存文件名"
                             ToolTip="输出文件名。双击从链接自动识别"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================== ZONE B & C: LEFT NAV SIDEBAR + MAIN CONTENT ================== -->
        <TabControl Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushCustom}" BorderThickness="1" TabStripPlacement="Left" MinWidth="160">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource LeftTabItemStyle}"/>
            </TabControl.Resources>

            <!-- TAB 1: DOWNLOAD & BASIC -->
            <TabItem Header="📦 下载" AutomationProperties.Name="下载">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="基本路径" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="可执行程序" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBox_EXE" Text="N_m3u8DL-RE.exe" 
                                         Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"
                                         AutomationProperties.Name="N_m3u8DL-RE 可执行程序路径"
                                         ToolTip="N_m3u8DL-RE 可执行程序路径">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="剪切" Command="Cut"/>
                                            <MenuItem Header="复制" Command="Copy"/>
                                            <MenuItem Header="粘贴" Command="Paste"/>
                                            <Separator/>
                                            <MenuItem Header="获取下载器" Click="Menu_GetDownloader"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="临时目录" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBox_TmpDir" Style="{StaticResource TextBoxStyle}"
                                         TextChanged="TextChanged" Margin="0,8,0,0"
                                         AutomationProperties.Name="临时目录路径"
                                         ToolTip="分片文件临时目录"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="下载选项" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="CheckBox_Del" AutomationProperties.Name="完成后删除临时文件" Style="{StaticResource CheckBoxStyle}"
                                              Content="完成后删除" ToolTip="合并后删除临时文件"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="CheckBox_DisableDate" AutomationProperties.Name="不写入日期信息" Style="{StaticResource CheckBoxStyle}"
                                              Content="不写入日期" ToolTip="封装时不写入日期信息"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    
                                    
                                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CheckBox_ParserOnly" AutomationProperties.Name="仅解析，跳过下载" Style="{StaticResource CheckBoxStyle}"
                                              Content="跳过下载" ToolTip="仅解析，不下载"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="CheckBox_Concurrent" AutomationProperties.Name="并发下载" Style="{StaticResource CheckBoxStyle}"
                                              Content="并发下载" ToolTip="同时下载音频/视频/字幕"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="2" x:Name="CheckBox_DisableMerge" AutomationProperties.Name="跳过合并" Style="{StaticResource CheckBoxStyle}"
                                              Content="跳过合并" ToolTip="下载后不合并分片"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    
                                    <CheckBox Grid.Row="2" Grid.Column="0" x:Name="CheckBox_BinaryMerge" AutomationProperties.Name="二进制合并" Style="{StaticResource CheckBoxStyle}"
                                              Content="二进制合并" ToolTip="使用二进制拼接代替 ffmpeg"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CheckBox_AudioOnly" AutomationProperties.Name="仅音频" Style="{StaticResource CheckBoxStyle}"
                                              Content="仅音频" ToolTip="仅下载音频轨道"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="2" x:Name="CheckBox_DisableCheck" AutomationProperties.Name="跳过分片数量校验" Style="{StaticResource CheckBoxStyle}"
                                              Content="跳过校验" ToolTip="不校验分片数量"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    
                                    <CheckBox Grid.Row="3" Grid.Column="0" x:Name="CheckBox_SubOnly" AutomationProperties.Name="仅字幕" Style="{StaticResource CheckBoxStyle}"
                                              Content="仅字幕" ToolTip="仅下载字幕"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="CheckBox_AutoSubFix" AutomationProperties.Name="自动修复字幕" Style="{StaticResource CheckBoxStyle}"
                                              Content="自动修复字幕" ToolTip="自动修复字幕时间轴"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="3" Grid.Column="2" x:Name="CheckBox_AutoSelect" AutomationProperties.Name="自动选择最佳画质" Style="{StaticResource CheckBoxStyle}"
                                              Content="自动选择" ToolTip="自动选择最佳画质"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="字幕格式：" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="Combo_SubFormat" AutomationProperties.Name="字幕格式" SelectedIndex="0" Width="100"
                                              SelectionChanged="Combo_SubFormat_SelectionChanged">
                                        <ComboBoxItem Content="SRT"/>
                                        <ComboBoxItem Content="VTT"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: NETWORK & SPEED -->
            <TabItem Header="🌐 网络" AutomationProperties.Name="网络">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="请求与代理" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="请求头" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBox_Headers" Style="{StaticResource TextBoxStyle}" 
                                         TextChanged="TextChanged"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="72"
                                         AutomationProperties.Name="HTTP 请求头"
                                         ToolTip="HTTP 请求头，用换行或 | 分隔（例如 Cookie:xxx&#x0a;User-Agent:yyy）"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="基础链接" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBox_Baseurl" Style="{StaticResource TextBoxStyle}" 
                                         TextChanged="TextChanged" Margin="0,8,0,0"
                                         AutomationProperties.Name="基础链接"
                                         ToolTip="覆盖相对路径的基础链接"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="代理" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="CheckBox_UseProxy" AutomationProperties.Name="使用代理" VerticalAlignment="Center" Margin="0,0,8,0"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Content="使用代理" ToolTip="勾选后按右侧地址走代理；不勾选（默认）直接连接，不使用任何代理"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_Proxy" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged"
                                             AutomationProperties.Name="代理地址"
                                             ToolTip="HTTP/SOCKS5 代理（例如 http://127.0.0.1:8080）；勾选“使用代理”但留空时使用系统代理"/>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="性能与限制" Style="{StaticResource GroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="线程数" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TextBox_Max" AutomationProperties.Name="最大下载线程数" Text="12" Width="45" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged" HorizontalContentAlignment="Center" ToolTip="最大下载线程数"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="重试" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TextBox_Retry" AutomationProperties.Name="下载重试次数" Text="3" Width="45" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged" HorizontalContentAlignment="Center" ToolTip="失败重试次数"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="超时" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TextBox_Timeout" AutomationProperties.Name="HTTP 请求超时（秒）" Text="100" Width="45" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged" HorizontalContentAlignment="Center" ToolTip="HTTP 超时（秒）"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="限速" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TextBox_MaxSpeed" AutomationProperties.Name="下载限速" Text="" Width="60" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged" HorizontalContentAlignment="Center" ToolTip="限速（例如 15M 或 500K）"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Cloudflare Bypass Section -->
                        <!-- "curl__cffi": the header ContentPresenter sets RecognizesAccessKey="True",
                             so WPF's AccessText eats a single underscore. Doubling it renders one. -->
                        <GroupBox Header="⚡ Cloudflare 绕过 (curl__cffi)" Style="{StaticResource GroupBoxStyle}" Foreground="{StaticResource CfAmberBrush}">
                            <StackPanel>
                                <CheckBox x:Name="CheckBox_BypassCF" AutomationProperties.Name="启用 Cloudflare 绕过" Content="启用 Cloudflare 绕过"
                                          Foreground="{StaticResource CfAmberBrush}" FontWeight="SemiBold" Margin="0,0,0,6"
                                          Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                
                                <Border x:Name="Border_CfScopeWarning" Visibility="Collapsed"
                                        Background="#2A2113" BorderBrush="{StaticResource CfAmberBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource CfAmberBrush}"
                                               AutomationProperties.Name="Cloudflare 模式范围警告"
                                               Text="Cloudflare 模式运行 Python 脚本而非 N_m3u8DL-RE。它仅使用输入链接、保存目录、保存名称以及本节字段 — 下载、安全、媒体、直播和高级页的选项将被忽略。"/>
                                </Border>
                                
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="指纹" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="1" x:Name="Combo_CFImpersonate" AutomationProperties.Name="Cloudflare TLS 指纹" SelectedIndex="0"
                                              SelectionChanged="Combo_CFImpersonate_SelectionChanged">
                                        <ComboBoxItem Content="chrome" Tag="chrome"/>
                                        <ComboBoxItem Content="chrome120" Tag="chrome120"/>
                                        <ComboBoxItem Content="chrome131" Tag="chrome131"/>
                                        <ComboBoxItem Content="edge101" Tag="edge101"/>
                                        <ComboBoxItem Content="safari17_0" Tag="safari17_0"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="来源页" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_CFReferer" AutomationProperties.Name="Cloudflare 来源页请求头" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CF Cookie" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_CFCookie" AutomationProperties.Name="Cloudflare Cookie" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                </Grid>

                                <CheckBox x:Name="CheckBox_CFKeepSegs" AutomationProperties.Name="合并后保留分片文件" Content="合并后保留分片文件"
                                          Style="{StaticResource CheckBoxStyle}" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: SECURITY & ENCRYPTION -->
            <TabItem Header="🔒 安全" AutomationProperties.Name="安全">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="密钥与向量" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="密钥" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBox_Key" Style="{StaticResource TextBoxStyle}" 
                                         TextChanged="TextChanged" AllowDrop="True"
                                         PreviewDragEnter="TextBox_Key_PreviewDragEnter" PreviewDragOver="TextBox_Key_PreviewDragOver" PreviewDrop="TextBox_Key_PreviewDrop"
                                         AutomationProperties.Name="解密密钥"
                                         ToolTip="解密密钥（HEX/Base64）或密钥文件路径。支持 KID:KEY 格式"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="HLS 密钥" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBox_CustomHLSKey" Style="{StaticResource TextBoxStyle}"
                                         TextChanged="TextChanged" Margin="0,8,0,0"
                                         AutomationProperties.Name="自定义 HLS 密钥"
                                         ToolTip="自定义 HLS 密钥（HEX/Base64）"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="IV" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TextBox_IV" Style="{StaticResource TextBoxStyle}" 
                                         TextChanged="TextChanged" Margin="0,8,0,0"
                                         AutomationProperties.Name="初始化向量 IV"
                                         ToolTip="自定义 HLS 初始化向量（HEX/Base64）"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="密钥文件" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TextBox_KeyTextFile" Style="{StaticResource TextBoxStyle}" 
                                         TextChanged="TextChanged" AllowDrop="True" Margin="0,8,0,0"
                                         AutomationProperties.Name="密钥文本文件路径"
                                         ToolTip="解密密钥文本文件路径"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="解密引擎" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="引擎" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="1" x:Name="Combo_DecryptionEngine" AutomationProperties.Name="解密引擎" SelectedIndex="0" SelectionChanged="Combo_DecryptionEngine_SelectionChanged">
                                        <ComboBoxItem Content="MP4DECRYPT"/>
                                        <ComboBoxItem Content="SHAKA_PACKAGER"/>
                                        <ComboBoxItem Content="FFMPEG"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="3" Text="HLS 方法" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="4" x:Name="Combo_CustomHLSMethod" AutomationProperties.Name="自定义 HLS 方法" SelectedIndex="0" SelectionChanged="Combo_HLSMethod_SelectionChanged">
                                        <ComboBoxItem Content="(Default)"/>
                                        <ComboBoxItem Content="AES_128"/>
                                        <ComboBoxItem Content="AES_128_ECB"/>
                                        <ComboBoxItem Content="CENC"/>
                                        <ComboBoxItem Content="CHACHA20"/>
                                        <ComboBoxItem Content="NONE"/>
                                        <ComboBoxItem Content="SAMPLE_AES"/>
                                        <ComboBoxItem Content="SAMPLE_AES_CTR"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="程序路径" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_DecryptionBinPath" AutomationProperties.Name="解密程序路径" Style="{StaticResource TextBoxStyle}" 
                                             TextChanged="TextChanged" ToolTip="解密程序路径（mp4decrypt/shaka-packager）"/>
                                </Grid>

                                <CheckBox x:Name="CheckBox_MP4RealTimeDecryption" AutomationProperties.Name="MP4 实时解密" Style="{StaticResource CheckBoxStyle}"
                                          Content="MP4 实时解密" Margin="0,10,0,0" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: MEDIA & STREAMS -->
            <TabItem Header="🎬 媒体" AutomationProperties.Name="媒体">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="流选择（正则过滤）" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="选择视频" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBox_SelectVideo" AutomationProperties.Name="选择视频正则" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="选择音频" Style="{StaticResource LabelStyle}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBox_SelectAudio" AutomationProperties.Name="选择音频正则" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="选择字幕" Style="{StaticResource LabelStyle}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TextBox_SelectSubtitle" AutomationProperties.Name="选择字幕正则" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="排除视频" Style="{StaticResource LabelStyle}" Foreground="{StaticResource DropLabelBrush}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TextBox_DropVideo" AutomationProperties.Name="排除视频正则" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="排除音频" Style="{StaticResource LabelStyle}" Foreground="{StaticResource DropLabelBrush}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TextBox_DropAudio" AutomationProperties.Name="排除音频正则" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="排除字幕" Style="{StaticResource LabelStyle}" Foreground="{StaticResource DropLabelBrush}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TextBox_DropSubtitle" AutomationProperties.Name="排除字幕正则" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="时间范围与封装" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="范围" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_RangeStart" AutomationProperties.Name="时间范围开始" Text="00:00:00" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                    <TextBlock Grid.Column="2" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="3" x:Name="TextBox_RangeEnd" AutomationProperties.Name="时间范围结束" Text="00:00:00" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="封装导入" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_MuxJson" AutomationProperties.Name="封装导入文件" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" AllowDrop="True"
                                             PreviewDragEnter="TextBox_MuxJson_PreviewDragEnter" PreviewDragOver="TextBox_MuxJson_PreviewDragOver" PreviewDrop="TextBox_MuxJson_PreviewDrop"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="CheckBox_MuxAfterDone" AutomationProperties.Name="下载后启用封装" Style="{StaticResource CheckBoxStyle}" Content="启用封装" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Column="1" x:Name="CheckBox_MuxKeepFiles" AutomationProperties.Name="封装后保留源文件" Style="{StaticResource CheckBoxStyle}" Content="保留文件" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Column="2" x:Name="CheckBox_MuxSkipSub" AutomationProperties.Name="封装时跳过字幕" Style="{StaticResource CheckBoxStyle}" Content="跳过字幕" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="格式" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="1" x:Name="Combo_MuxFormat" AutomationProperties.Name="封装输出格式" SelectedIndex="0" SelectionChanged="Combo_MuxFormat_SelectionChanged">
                                        <ComboBoxItem Content="mp4"/>
                                        <ComboBoxItem Content="mkv"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="3" Text="封装器" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="4" x:Name="Combo_Muxer" AutomationProperties.Name="封装器" SelectedIndex="0" SelectionChanged="Combo_Muxer_SelectionChanged">
                                        <ComboBoxItem Content="ffmpeg"/>
                                        <ComboBoxItem Content="mkvmerge"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="6" Text="程序路径" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="7" x:Name="TextBox_MuxBinPath" AutomationProperties.Name="封装器程序路径" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: LIVE RECORDING -->
            <TabItem Header="📡 直播" AutomationProperties.Name="直播">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="直播录制选项" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="CheckBox_LivePerformAsVod" AutomationProperties.Name="将直播流按点播处理" Style="{StaticResource CheckBoxStyle}" Content="按点播处理" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="CheckBox_LiveRealTimeMerge" AutomationProperties.Name="直播实时合并" Style="{StaticResource CheckBoxStyle}" Content="实时合并" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="2" x:Name="CheckBox_LiveKeepSegments" AutomationProperties.Name="保留直播分片" Style="{StaticResource CheckBoxStyle}" Content="保留分片" IsChecked="True" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>

                                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CheckBox_LivePipeMux" AutomationProperties.Name="直播管道封装" Style="{StaticResource CheckBoxStyle}" Content="管道封装" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="CheckBox_LiveFixVttByAudio" AutomationProperties.Name="根据音频修复直播 VTT" Style="{StaticResource CheckBoxStyle}" Content="根据音频修复 VTT" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="录制限制" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TextBox_LiveRecordLimit" AutomationProperties.Name="直播录制时间限制" Width="70" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" HorizontalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="等待（秒）" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TextBox_LiveWaitTime" AutomationProperties.Name="直播等待时间（秒）" Width="50" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" HorizontalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="取数" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TextBox_LiveTakeCount" AutomationProperties.Name="直播分片取数" Text="16" Width="50" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: ADVANCED & LOGS -->
            <TabItem Header="⚙️ 高级" AutomationProperties.Name="高级">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="自定义路径与变量" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="保存模板" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBox_SavePattern" AutomationProperties.Name="保存名称模板" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="日志文件" Style="{StaticResource LabelStyle}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBox_LogFilePath" AutomationProperties.Name="日志文件路径" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="FFmpeg 路径" Style="{StaticResource LabelStyle}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TextBox_FFmpegPath" AutomationProperties.Name="FFmpeg 程序路径" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="广告关键词" Style="{StaticResource LabelStyle}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TextBox_AdKeyword" AutomationProperties.Name="广告关键词过滤" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="URL 参数" Style="{StaticResource LabelStyle}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TextBox_UrlProcessorArgs" AutomationProperties.Name="URL 处理器参数" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="开始时间" Style="{StaticResource LabelStyle}" Margin="0,6,8,0"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TextBox_TaskStartAt" AutomationProperties.Name="计划开始时间" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="环境与系统标志" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="日志级别" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="1" x:Name="Combo_LogLevel" AutomationProperties.Name="下载器日志级别" SelectedIndex="2" SelectionChanged="Combo_LogLevel_SelectionChanged">
                                        <ComboBoxItem Content="DEBUG"/>
                                        <ComboBoxItem Content="ERROR"/>
                                        <ComboBoxItem Content="INFO"/>
                                        <ComboBoxItem Content="WARN"/>
                                        <ComboBoxItem Content="OFF"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="3" Text="下载器语言" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="4" x:Name="Combo_UILanguage"
                                              AutomationProperties.Name="下载器控制台语言"
                                              ToolTip="N_m3u8DL-RE 自身控制台输出的语言。不会改变 GUI 界面语言。"
                                              SelectedIndex="0" SelectionChanged="Combo_UILanguage_SelectionChanged">
                                        <ComboBoxItem Content="(Default)"/>
                                        <ComboBoxItem Content="en-US"/>
                                        <ComboBoxItem Content="zh-CN"/>
                                        <ComboBoxItem Content="zh-TW"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="CheckBox_AppendUrlParams" AutomationProperties.Name="附加 URL 参数" Style="{StaticResource CheckBoxStyle}" Content="附加 URL 参数" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="CheckBox_NoLog" AutomationProperties.Name="禁用日志文件" Style="{StaticResource CheckBoxStyle}" Content="不记录日志" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="2" x:Name="CheckBox_WriteMetaJson" AutomationProperties.Name="写入元数据 JSON" Style="{StaticResource CheckBoxStyle}" Content="写入元数据 JSON" IsChecked="True" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>

                                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CheckBox_UseFFmpegConcat" AutomationProperties.Name="使用 FFmpeg Concat 分离器" Style="{StaticResource CheckBoxStyle}" Content="FFmpeg 拼接" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="CheckBox_AllowHlsMultiExtMap" AutomationProperties.Name="允许多个 HLS EXT-X-MAP" Style="{StaticResource CheckBoxStyle}" Content="多 EXT-MAP" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="2" x:Name="CheckBox_DisableUpdateCheck" AutomationProperties.Name="禁用下载器更新检查" Style="{StaticResource CheckBoxStyle}" Content="不检查更新" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>

                                    <CheckBox Grid.Row="2" Grid.Column="0" x:Name="CheckBox_ForceAnsiConsole" AutomationProperties.Name="强制 ANSI 控制台" Style="{StaticResource CheckBoxStyle}" Content="强制 ANSI 控制台" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CheckBox_NoAnsiColor" AutomationProperties.Name="禁用 ANSI 颜色" Style="{StaticResource CheckBoxStyle}" Content="无 ANSI 颜色" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="🔄 GUI 自动更新" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="CheckBox_AutoCheckGuiUpdate" AutomationProperties.Name="启动时自动检查 GUI 更新" Style="{StaticResource CheckBoxStyle}"
                                              Content="启动时自动检查 GUI 更新" IsChecked="True"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock x:Name="TextBlock_UpdateStatus" Text="" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="Button_CheckUpdate" AutomationProperties.Name="立即检查 GUI 更新" Content="立即检查"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="Button_CheckUpdate_Click" Padding="10,3"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================== ZONE D: STATUS + LOG + COMMAND BAR ================== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushCustom}" BorderThickness="1"
                Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <!-- Status strip -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="ProgressBar_Download" Grid.Column="0"
                                 Height="8" Minimum="0" Maximum="100" Value="0"
                                 Background="{StaticResource CardBrush}"
                                 Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0" VerticalAlignment="Center"
                                 AutomationProperties.Name="下载进度"/>

                    <TextBlock x:Name="TextBlock_Status" Grid.Column="1" Text="就绪"
                               Style="{StaticResource LabelStyle}" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="下载状态"
                               AutomationProperties.LiveSetting="Polite"/>

                    <Button x:Name="Button_OpenFolder" Grid.Column="2" Content="打开文件夹"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Button_OpenFolder_Click" Padding="8,2" FontSize="13"
                            Visibility="Collapsed" Margin="0,0,6,0"
                            AutomationProperties.Name="打开输出文件夹"
                            ToolTip="打开下载保存所在的文件夹"/>

                    <ToggleButton x:Name="ToggleButton_Log" Grid.Column="3" Content="日志"
                                  Padding="8,2" FontSize="13" Cursor="Hand"
                                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrushCustom}" BorderThickness="1"
                                  Checked="ToggleButton_Log_Changed" Unchecked="ToggleButton_Log_Changed"
                                  AutomationProperties.Name="切换下载日志"
                                  ToolTip="显示或隐藏下载日志"/>
                </Grid>

                <!-- Log panel (collapsed by default) -->
                <TextBox x:Name="TextBox_Log" Visibility="Collapsed"
                         Height="150" Margin="0,0,0,6"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource CommandBarBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrushCustom}" BorderThickness="1"
                         FontFamily="Consolas" FontSize="13"
                         AutomationProperties.Name="下载日志"/>

                <!-- Command bar (unchanged) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="命令：" Style="{StaticResource LabelStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TextBox_Parameter" Style="{StaticResource TextBoxStyle}"
                             IsReadOnly="True" ToolTip="生成的命令行参数"
                             AutomationProperties.Name="生成的命令预览"
                             Background="{StaticResource CommandBarBrush}" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource CommandTextBrush}"/>
                    <Button Grid.Column="2" x:Name="Button_CopyCommand" Content="📋 复制"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Button_CopyCommand_Click" Margin="6,0,0,0" Padding="8,2" FontSize="13"
                            AutomationProperties.Name="复制命令到剪贴板"
                            ToolTip="复制生成的命令到剪贴板"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
